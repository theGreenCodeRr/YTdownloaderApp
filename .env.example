# Copy this file to `.env` on the server, in the SAME folder as docker-compose.yml
# (e.g. /opt/deployments/ytdown/.env), then protect it:  chmod 600 .env
# `.env` is git-ignored and docker-ignored, so it is never committed or baked into the image.

# Password for multi-video / playlist ZIP downloads.
# If empty, playlist ZIP downloads are disabled (single videos still work).
# Generate one with:  openssl rand -base64 24
PREMIUM_PASSWORD=change-me-to-a-long-random-password

# Websites allowed to call this API from a browser (comma separated).
# Leave empty if you only use the built-in web page and/or a native mobile app.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=https://yt.quantumsofts.com

# IP address(es) of your reverse proxy (Nginx / Nginx Proxy Manager / Traefik / Cloudflare Tunnel...).
# Needed so rate limiting sees each visitor's real IP instead of the proxy's IP.
#  - Default covers localhost, Docker bridge networks (172.16.0.0/12), and LAN proxies (192.168.1.0/24)
#    such as Cloudflare -> Nginx Proxy -> http://192.168.1.5:8000 (https://yt.quantumsofts.com).
#  - Restrict further (e.g. to your exact Nginx proxy IP) if untrusted LAN clients hit port 8000 directly.
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,192.168.1.0/24

# Rate limits per visitor IP, format <requests>/<seconds>. Use 0/1 to disable one.
RATE_LIMIT_INFO=30/60
RATE_LIMIT_PROCESS=10/60
RATE_LIMIT_PLAYLIST=5/3600
RATE_LIMIT_PASSWORD_FAILS=5/900
MAX_ACTIVE_TASKS_PER_IP=3

# Seconds a finished file stays downloadable after it was first saved
SERVE_GRACE_SECONDS=600

# Only set to true if TLS fails because of a corporate/intercepting proxy
YTDLP_NO_CHECK_CERTIFICATE=false

