secrets/
data/
*.db
*.db-shm
*.db-wal
downloads/
tmp/

# Not needed in the image
.git
.github
.idea
.vscode
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
README.md
mobile/

